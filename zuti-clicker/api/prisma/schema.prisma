// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id             Int             @id @default(autoincrement())
  username       String          @unique
  email          String          @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  authentication Authentication?
  gameSave       GameSave?
  settings       UserSettings?
}

model Authentication {
  id           Int    @id @default(autoincrement())
  userId       Int    @unique
  user         User   @relation(fields: [userId], references: [id])
  password     String
  salt         String
  sessionToken String
}

model GameSave {
  id                Int             @id @default(autoincrement())
  userId            Int             @unique
  user              User            @relation(fields: [userId], references: [id])
  tokens            Float           @default(0)
  totalTokensEarned Float           @default(0)
  totalClicks       Int             @default(0)
  elapsedSeconds    Float           @default(0)
  phdCount          Int             @default(0)
  prestigeCount     Int             @default(0)
  runTokensEarned   Float           @default(0)
  runClicks         Int             @default(0)
  runSeconds        Float           @default(0)
  // Booster anti-cheat state (see ActiveBooster below): the earliest instant
  // at which the next POST /boosters/claim may succeed. Defaulting to "now"
  // makes every pre-existing row immediately claimable, which is correct.
  boostersCollected Int             @default(0)
  nextBoosterAt     DateTime        @default(now())
  savedAt           DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  units             UnitSave[]
  upgrades          UpgradeSave[]
  activeBoosters    ActiveBooster[]

  // Support ORDER BY ... DESC LIMIT queries for each leaderboard metric.
  @@index([totalTokensEarned])
  @@index([totalClicks])
  @@index([phdCount])
  @@index([elapsedSeconds])
}

model UnitSave {
  id         Int      @id @default(autoincrement())
  gameSaveId Int
  gameSave   GameSave @relation(fields: [gameSaveId], references: [id], onDelete: Cascade)
  unitId     String   @db.VarChar(32)
  owned      Int      @default(0)

  @@unique([gameSaveId, unitId])
}

// One-time click-power purchases (flat/multiplier/synergy/crit/booster
// families — see frontend/src/utils/gameConstants.ts). Unlike UnitSave,
// there is no `owned` count: presence of a row means the upgrade is bought.
// Reset (deleted wholesale) on prestige, same as UnitSave.
model UpgradeSave {
  id         Int      @id @default(autoincrement())
  gameSaveId Int
  gameSave   GameSave @relation(fields: [gameSaveId], references: [id], onDelete: Cascade)
  upgradeId  String   @db.VarChar(32)

  @@unique([gameSaveId, upgradeId])
}

// Server-issued, server-timed booster buffs (see POST /boosters/claim). Never
// written by PUT /save — the client cannot assert or extend a buff, only the
// claim endpoint (rate-limited by GameSave.nextBoosterAt) can create one.
// A second claim of an already-active type refreshes expiresAt in place.
model ActiveBooster {
  id         Int      @id @default(autoincrement())
  gameSaveId Int
  gameSave   GameSave @relation(fields: [gameSaveId], references: [id], onDelete: Cascade)
  boosterId  String   @db.VarChar(32)
  expiresAt  DateTime

  @@unique([gameSaveId, boosterId])
}

model UserSettings {
  id                   Int      @id @default(autoincrement())
  userId               Int      @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme                String   @default("dark") @db.VarChar(16)
  language             String   @default("en") @db.VarChar(16)
  autosaveEnabled      Boolean  @default(true)
  autosaveIntervalSecs Int      @default(30)
  prestigeCeremony     String   @default("full") @db.VarChar(16)
  hideFromLeaderboards Boolean  @default(false)
  updatedAt            DateTime @updatedAt
}
